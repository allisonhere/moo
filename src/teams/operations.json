   "kind": "append_chat",
   "team_id": "alpha",
   "message_id": "m1",
   "body": "hello team",
   "audience": {
    "to": "team"
   }
  }
 },
 {
  "kind": "put_knowledge",
  "area": "chat",
  "summary": "Record project or team knowledge.",
  "sample": {
   "kind": "put_knowledge",
   "team_id": "alpha",
   "knowledge_id": "k1",
   "scope": {
    "scope": "team",
    "team_id": "alpha"
   },
   "title": "ADR-1",
   "body": "use queues",
   "evidence": []
  }
 },
 {
  "kind": "create_task",
  "area": "tasks",
