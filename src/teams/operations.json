 },
 {
  "kind": "submit_handoff",
  "area": "tasks",
  "summary": "The Developer hands a task to QA with evidence.",
  "sample": {
   "kind": "submit_handoff",
   "team_id": "alpha",
   "task_id": "t1",
   "handoff_id": "h1",
