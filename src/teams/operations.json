 {
  "kind": "request_approval",
  "area": "approvals",
  "summary": "Ask the Owner to authorize one exact protected action.",
  "sample": {
   "kind": "request_approval",
   "approval_id": "ap1",
   "team_id": "alpha",
   "action": {
    "kind": "protected_branch_integration",
    "target": "main",
    "parameters": {
     "integration_id": "i1",
     "commit": "1111111111111111111111111111111111111111"
    }
   },
   "justification": "tests green",
   "alternatives": [
    "wait"
   ],
   "risks": [
    "touches the API"
   ],
   "ttl_seconds": 3600
  }
 },
 {
  "kind": "decide_approval",
  "area": "approvals",
  "summary": "The Owner approves or denies. Never reachable through chat.",
  "sample": {
   "kind": "decide_approval",
   "approval_id": "ap1",
   "approve": true,
   "rationale": "reviewed"
  }
 },
 {
  "kind": "revoke_approval",
  "area": "approvals",
  "summary": "The Owner revokes a pending or unused approval.",
  "sample": {
   "kind": "revoke_approval",
   "approval_id": "ap1",
   "rationale": "changed my mind"
  }
 },
 {
  "kind": "consume_approval",
  "area": "approvals",
  "summary": "Spend an approval once, for exactly the approved action.",
  "sample": {
   "kind": "consume_approval",
   "approval_id": "ap1",
   "execution_id": "exec-1",
   "action": {
    "kind": "protected_branch_integration",
    "target": "main",
    "parameters": {
     "integration_id": "i1",
     "commit": "1111111111111111111111111111111111111111"
    }
   }
  }
 },
