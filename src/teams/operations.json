   "kind": "create_team_spec",
   "spec_id": "alpha-spec",
   "project_id": "moo",
   "name": "Alpha"
  }
 },
 {
  "kind": "enroll_actor",
  "area": "teams",
  "summary": "Enroll the Lead, Developer or QA of a draft with a credential digest.",
