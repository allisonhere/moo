   "evidence": [
    {
     "kind": "test",
     "reference": "cargo nextest run"
    }
   ],
   "dispatch": {
    "attempt_id": "attempt-2",
    "run_generation": 1,
    "content_digest": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
   }
  }
 },
 {
  "kind": "review_handoff",
  "area": "tasks",
