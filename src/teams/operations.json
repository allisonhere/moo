   "kind": "unbind_agent_pane",
   "actor_id": "alpha-dev"
  }
 },
 {
  "kind": "request_recruitment",
  "area": "agents",
  "summary": "Ask for a temporary specialist, within bounds.",
  "sample": {
   "kind": "request_recruitment",
   "recruitment_id": "r1",
   "team_id": "alpha",
   "specialty": "security",
   "justification": "audit",
   "deliverable": "review notes",
   "capabilities": [
    "review"
   ],
   "dependencies": [],
   "stop_condition": "notes delivered",
   "max_retries": 1,
   "max_minutes": 30
  }
 },
 {
  "kind": "activate_recruitment",
  "area": "agents",
  "summary": "Start the specialist for an authorized recruitment.",
  "sample": {
   "kind": "activate_recruitment",
   "recruitment_id": "r1",
   "actor_id": "sec-1",
   "credential_digest": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
   "run_generation": 1
  }
 },
 {
  "kind": "submit_specialist_handoff",
  "area": "agents",
  "summary": "The specialist hands off its deliverable with evidence.",
  "sample": {
   "kind": "submit_specialist_handoff",
   "recruitment_id": "r1",
   "summary": "no blocking issues",
   "evidence": [
    {
     "kind": "test",
     "reference": "cargo nextest run"
    }
   ]
  }
 },
 {
  "kind": "verify_recruitment",
  "area": "agents",
  "summary": "The Lead accepts or rejects a specialist's handoff.",
  "sample": {
   "kind": "verify_recruitment",
   "recruitment_id": "r1",
   "accepted": true,
   "rationale": "evidence ok"
  }
 },
 {
  "kind": "cancel_recruitment",
  "area": "agents",
  "summary": "Cancel a specialist engagement.",
  "sample": {
   "kind": "cancel_recruitment",
   "recruitment_id": "r1",
   "reason": "no longer needed"
  }
 },
 {
  "kind": "append_chat",
  "area": "chat",
  "summary": "Post a message to the team, a role or one agent (the audience field).",
